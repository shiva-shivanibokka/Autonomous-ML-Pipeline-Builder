# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
.env

# Secrets — never commit
.env
*.key
*secrets*

# MLflow
mlruns/
mlartifacts/

# Pipeline outputs (generated artifacts — large, gitignored)
outputs/

# Uploads & run store
/tmp/ml_pipeline_uploads/
uploads/
data/
runs.db

# Model checkpoints
*.pkl
*.joblib
*.ckpt
*.pt
*.pth

# ...except the recorded demo run's artifacts, which are the whole point of
# web/public/demo/ and have to ship. Without this, `*.pkl` and `*.csv` above
# silently dropped model.pkl from the recording and the download link 404'd.
!web/public/demo/artifacts/**

# Data files (large CSVs)
*.csv

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes
postgres_data/
redis_data/
mlflow_data/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Logs
*.log
logs/
