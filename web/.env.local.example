# Base URL of the FastAPI backend.
# Local dev: the default below. Hosted: your Cloud Run service URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Replay mode. Set to 1 for a deploy with no backend behind it (e.g. Vercel):
# the console loads /demo/run.json and replays a recorded run instead of trying
# to reach an API that is not there. Capture one first:
#   python scripts/record_demo_run.py --csv ... --problem ...
# Leave at 0 for local development against a real backend — the replay is still
# available from the button on the page.
NEXT_PUBLIC_DEMO_MODE=0
